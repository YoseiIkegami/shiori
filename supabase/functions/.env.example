# APP_ORIGIN=https://shiori.ikg-systems.com
#
# Stripe (create-trip-checkout / stripe-webhook)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_BASE_CURRENCY=jpy
# STRIPE_BASE_AMOUNT=150
#
# Organizer transaction email (Phase email — stub only until configured)
# RESEND_API_KEY=re_...
# RESEND_FROM=SHIORI <noreply@your-verified-domain>
#
# Display price on /create (must match STRIPE_BASE_AMOUNT above)
