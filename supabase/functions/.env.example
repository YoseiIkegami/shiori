# Edge Function secrets (set via `supabase secrets set` or Dashboard)
# ALLOWED_ORIGIN=https://shiori.ikg-systems.com
# APP_ORIGIN=https://shiori.ikg-systems.com
#
# Stripe (create-trip-checkout / stripe-webhook)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_BASE_CURRENCY=jpy
# STRIPE_BASE_AMOUNT=150
#
# RESEND_API_KEY=re_...
# RESEND_FROM=SHIORI <support-shiori@ikg-systems.com>
#
# purge-expired-trips（任意。設定時は Cron ヘッダ必須）
# CRON_SECRET=long-random-string
#
# Display price on /create (must match STRIPE_BASE_AMOUNT above)
# VITE_STRIPE_BASE_AMOUNT=150
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically
# when deployed to Supabase Edge Functions.
