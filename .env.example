# Supabase project URL (Project Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase anon / publishable key (safe for client; never put service_role here)
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Display price on /create (must match STRIPE_BASE_AMOUNT on Edge Functions; see supabase/functions/.env.example)
VITE_STRIPE_BASE_AMOUNT=150
